-- RENT DECREASE FORMULA
CREATE FUNCTION RentDecrease( 
    @setRent DECIMAL(10,2), 
    @monthsOut INT, 
    @collegeDistance INT, 
    @vacancyRates DECIMAL(10,2), 
    @avgSimilarRents DECIMAL(10,2)

	
)
RETURNS DECIMAL(10,2)
AS 
BEGIN
    DECLARE @locationScore DECIMAL(10,2);
    DECLARE @vacancyScore DECIMAL(10,2);
    DECLARE @marketRent DECIMAL(10,2);
	DECLARE @12MonthsOutRent DECIMAL(10,2);

    -- Calculate locationScore
	--SET @setRent = .35 * (@setRent * @vacancyScore) + .20 * (@setRent * @locationScore) + .45 * (@setRent + (@setRent * .01 * (6)));
    IF @collegeDistance BETWEEN 0 AND 30 
        SET @locationScore = 1 + ((ABS(@collegeDistance - 30))/100);
    ELSE IF @collegeDistance > 31 
        SET @locationScore = 1 - ((ABS(@collegeDistance - 30))/100);;
    ELSE 
        SET @locationScore = 0;  -- Default value for other cases

    -- Calculate vacancyScore
    IF @vacancyRates BETWEEN 0 AND 3 
        SET @vacancyScore = 1.03;
    ELSE IF @vacancyRates BETWEEN 3 AND 6 
        SET @vacancyScore = 1;
    ELSE 
        SET @vacancyScore = .97;

    -- Calculate market rent
	SET @12MonthsOutRent = dbo.RentIncrease(@setRent, 12, @collegeDistance, @vacancyRates, @avgSimilarRents);
 -- IF @monthsOut = 11
		SET @marketRent = .35 * (@12MonthsOutRent * @vacancyScore) + .20 * (@12MonthsOutRent * @locationScore) + .45 * (@12MonthsOutRent - (@12MonthsOutRent * .01 * (18 - @monthsOut)))
	--ELSE
	--	SET @marketRent = .35 * (@setRent * @vacancyScore) + .20 * (@setRent * @locationScore) + .45 * (@setRent - (@setRent * .01 * (18 - @monthsOut)))

    RETURN @marketRent;
END;
GO


-- Hardcoded table of months out from 18 to 12
WITH CustomDecreasingValue AS (
    SELECT 18 AS MonthsOut UNION ALL
    SELECT 17 UNION ALL
    SELECT 16 UNION ALL
    SELECT 15 UNION ALL
    SELECT 14 UNION ALL
    SELECT 13 UNION ALL
    SELECT 12
),
SelectedUnit AS (
    SELECT TOP 1 *
    FROM dbo.PropertyInfo
    WHERE PropertyName = 'Pinecrest Village' --SPECIFIC APARTMENT
      AND Unit = '102' -- SPECIFIC UNIT
     --
)
SELECT 
    su.PropertyName,
    su.Unit,
    su.LeaseStart,
    su.SetMonthlyRent AS CurrentRent,
    su.CollegeDistance,
    su.VacancyRates,
    cdv.MonthsOut,
    dbo.RentIncrease(
        su.SetMonthlyRent,     -- @setRent
        cdv.MonthsOut,         -- @monthsOut from simulated time
        su.CollegeDistance,    -- from table
        su.VacancyRates,       -- from table
        850                    -- still hardcoded avgSimilarRents (you could make this dynamic too)
    ) AS ProjectedRentAtMonthOut
FROM CustomDecreasingValue cdv
CROSS JOIN SelectedUnit su
ORDER BY cdv.MonthsOut DESC;



